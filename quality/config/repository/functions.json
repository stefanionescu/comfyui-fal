{
    "version": 1,
    "python": {
        "max_trivial_statements": 2,
        "verbs": [
            "read",
            "save",
            "send",
            "parse",
            "build",
            "create",
            "choose",
            "list",
            "find",
            "plan",
            "rank",
            "validate",
            "describe",
            "format",
            "get",
            "set",
            "reset",
            "decode",
            "encode",
            "sanitize",
            "wait",
            "register",
            "delete",
            "download",
            "measure",
            "place"
        ],
        "predicates": ["is", "has"],
        "named_paths": ["src/", "scripts/", "__init__.py"],
        "allowlist": [
            {
                "path": "__init__.py",
                "names": ["comfy_entrypoint", "Extension.on_load", "Extension.get_node_list"],
                "reason": "ComfyUI calls these extension hooks itself."
            },
            {
                "path": "src/types/credentials.py",
                "names": ["Credential.reveal"],
                "reason": "Revealing the key is an explicit call at the fal boundary, so no caller reads it by accident."
            },
            {
                "path": "src/settings/routes.py",
                "names": ["ConfigurationRoutes.read_status"],
                "reason": "aiohttp calls this route handler itself."
            },
            {
                "path": "src/types/parsing.py",
                "names": ["parse_fields"],
                "reason": "The paid nodes' arguments check calls it from the Media and requests milestone."
            },
            {
                "path": "src/fal/failures.py",
                "names": ["build_failure"],
                "reason": "The queue operation reads a failed request with it from the Media and requests milestone."
            },
            {
                "path": "src/fal/transport.py",
                "names": ["download_output", "read_status_stream", "send_cancel", "send_json"],
                "reason": "The queue operation calls these from the Media and requests milestone."
            },
            {
                "path": "src/fal/models.py",
                "names": ["read_fal_model"],
                "reason": "Model: Info and the paid nodes read models here; 08 removes this entry with QueueOperation."
            },
            {
                "path": "src/comfy/media.py",
                "names": ["decode_audio", "decode_images", "decode_mesh", "decode_video", "encode_local_file"],
                "reason": "The paid node encodes its local files and decodes its outputs with these from the Media and requests milestone."
            },
            {
                "path": "src/fal/outputs.py",
                "names": ["choose_output_text", "decode_inline_file", "list_output_files"],
                "reason": "The queue operation reads a result with these from the Media and requests milestone."
            },
            {
                "path": "src/fal/options.py",
                "names": ["build_request_headers"],
                "reason": "The queue operation in plan 08 calls it; it removes this entry with its first call."
            }
        ]
    },
    "shell": {
        "max_trivial_statements": 2
    }
}
