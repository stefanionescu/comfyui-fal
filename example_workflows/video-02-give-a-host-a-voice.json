      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "ElevenLabs v4 reads the sentence in **Voice** aloud. **Voice** holds the model's `arguments`, its own settings by fal's names, and ElevenLabs takes its words as `text`. Wan copies the sound of this voice, not its words. To use a recording of a real voice, connect **Load Audio** to the last **File: Add**'s `file` instead."
      ],
      "title": "Note"
    },
    {
      "id": 5,
      "type": "MarkdownNote",
      "pos": [
        2100,
        60
      ],
      "size": [
        1160,
        108
      ],
      "flags": {},
