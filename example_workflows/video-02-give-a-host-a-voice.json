      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "1. Set your key in **ComfyUI menu → Extensions → fal → fal Settings**.\n2. Describe the host in **Host** and the product in **Product**.\n3. In **Voice**, write any sentence after `\"text\":`, inside the quotation marks. The host will sound like this clip.\n4. In **Scene**, say what happens, and put the host's words in double quotation marks.\n5. Press **Run**. The voice clip and the video are saved under `audio/fal` and `video/fal`."
      ],
      "title": "Start Here"
    },
