          }
        }
      ],
      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "Seedream 5.0 lite draws the posters as one related series, so the style and the typeface match. It decides how many to make from the prompt, up to the four `max_images` allows, and each poster it makes is billed."
      ],
      "title": "Note"
    },
