      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "FLUX.2 klein draws the host in a vertical frame. This image becomes the video's first frame. `files` passes its fal link, its address on fal storage, on to **Animate**, so nothing is uploaded again."
      ],
      "title": "Note"
    },
    {
      "id": 3,
      "type": "MarkdownNote",
      "pos": [
        860,
        60
      ],
      "size": [
