            "name": "text"
          }
        }
      ],
      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "**File: Add** gives Demucs the song as `audio_url`. Demucs splits it into one clip per instrument (a stem): vocals, drums, bass, guitar, piano, and everything else. `audio` holds the six clips, and **Save Audio (Advanced)** saves each. To get fewer, put `stems` in `arguments`, such as `{\"stems\": [\"vocals\", \"drums\"]}`."
      ],
      "title": "Note"
    },
